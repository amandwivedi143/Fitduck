# ============================================================
# Environment variables — copy to .env and fill in your values
# cp .env.example .env
# ============================================================

# Google OAuth2 Web Client ID (used by gateway + frontend)
GOOGLE_CLIENT_ID=775509038693-bshcj00biq64gdc5r09ilnk18serure0.apps.googleusercontent.com

# Groq API key (AI service — DO NOT commit a real key to git)
GROQ_API_KEY=your-groq-api-key-here

# MySQL root password (empty = no password, which is the dev default)
MYSQL_PASSWORD=

# App JWT secret (gateway — must be >= 32 chars; change for production!)
APP_JWT_SECRET=dev-only-super-secret-change-me-in-production-please-32chars
